generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// CUSTOMERS
// =====================================================================

model Customer {
  id                       String   @id @default(cuid())
  name                     String
  email                    String?
  phone                    String?
  normalizedPhone          String
  normalizedPhoneValidated String?
  phoneNote                String?
  optOut                   Boolean  @default(false)
  source                   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  orders             Order[]
  abandonedCheckouts AbandonedCheckout[]
  messageLogs        MessageLog[]        @relation("CustomerMessages")

  @@index([normalizedPhone])
  @@index([email])
  @@index([optOut])
  @@map("customers")
}

// =====================================================================
// ORDERS
// =====================================================================

model Order {
  id               String    @id @default(cuid())
  nuvemshopOrderId String    @unique
  orderNumber      String
  customerId       String?
  customerName     String
  customerEmail    String?
  customerPhone    String?
  normalizedPhone  String
  total            Decimal   @db.Decimal(12, 2)
  currency         String    @default("BRL")
  paymentStatus    String
  paymentMethod    String?
  status           String
  orderUrl         String?
  webhookTopic     String?
  rawPayload       Json
  source           String?
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer           Customer?           @relation(fields: [customerId], references: [id])
  convertedCheckouts AbandonedCheckout[] @relation("ConvertedCheckoutOrder")

  @@index([nuvemshopOrderId])
  @@index([normalizedPhone])
  @@index([customerEmail])
  @@index([paymentStatus])
  @@index([status])
  @@index([webhookTopic])
  @@index([sourceCreatedAt])
  @@map("orders")
}

// =====================================================================
// ABANDONED CHECKOUTS
// =====================================================================

model AbandonedCheckout {
  id                   String                  @id @default(cuid())
  nuvemshopCheckoutId  String                  @unique
  token                String?
  customerId           String?
  customerName         String
  customerEmail        String?
  customerPhone        String?
  normalizedPhone      String
  total                Decimal?                @db.Decimal(12, 2)
  currency             String                  @default("BRL")
  productsSummary      String?
  abandonedCheckoutUrl String
  status               AbandonedCheckoutStatus @default(abandoned)
  rawPayload           Json
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  convertedAt          DateTime?
  convertedOrderId     String?
  sourceCreatedAt      DateTime?
  sourceUpdatedAt      DateTime?
  abandonedAt          DateTime?
  collectedAt          DateTime                @default(now())
  source               String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  customer       Customer? @relation(fields: [customerId], references: [id])
  convertedOrder Order?    @relation("ConvertedCheckoutOrder", fields: [convertedOrderId], references: [id])

  @@index([nuvemshopCheckoutId])
  @@index([normalizedPhone])
  @@index([customerEmail])
  @@index([status])
  @@index([convertedAt])
  @@index([sourceCreatedAt])
  @@index([sourceUpdatedAt])
  @@index([convertedOrderId])
  @@map("abandoned_checkouts")
}

enum AbandonedCheckoutStatus {
  abandoned
  converted
  skipped
}

// =====================================================================
// WHATSAPP TEMPLATES
// =====================================================================

model WhatsappTemplate {
  id               String           @id @default(cuid())
  name             String
  eventType        String
  metaTemplateName String
  languageCode     String           @default("pt_BR")
  category         TemplateCategory
  messagePreview   String
  variables        Json
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([eventType])
  @@index([metaTemplateName])
  @@index([active])
  @@index([category])
  @@map("whatsapp_templates")
}

enum TemplateCategory {
  utility
  marketing
  authentication
}

// =====================================================================
// AUTOMATION RULES
// =====================================================================

model AutomationRule {
  id                String    @id @default(cuid())
  name              String
  eventType         EventType
  templateName      String
  delayMinutes      Int       @default(0)
  active            Boolean   @default(true)
  maxSendsPerEntity Int       @default(1)
  stopIfOrderExists Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([eventType])
  @@index([active])
  @@index([templateName])
  @@map("automation_rules")
}

enum EventType {
  order_created
  abandoned_checkout
  order_created_boleto
  boleto_expiring
  order_created_pix
  payment_confirmed
  payment_rejected
  pix_cancelled
}

// =====================================================================
// MESSAGE LOGS
// =====================================================================

model MessageLog {
  id                 String        @id @default(cuid())
  idempotencyKey     String
  entityType         EntityType
  entityId           String
  customerId         String?
  normalizedPhone    String
  templateName       String
  status             MessageStatus @default(pending)
  reason             String?
  errorCode          String?
  metaMessageId      String?
  acceptedAt         DateTime?
  deliveryUnknownAt  DateTime?
  claimOwner         String?
  claimExpiresAt     DateTime?
  templateLanguage   String?
  templateParameters Json?
  renderedPreview    String?
  templateHash       String?
  mirrorStatus       MirrorStatus  @default(pending)
  mirrorRetryCount   Int           @default(0)
  mirrorLastError    String?
  mirroredAt         DateTime?
  payload            Json?
  response           Json?
  retryCount         Int           @default(0)
  lastRetryAt        DateTime?
  nextRetryAt        DateTime?
  scheduledAt        DateTime
  sentAt             DateTime?
  source             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer Customer? @relation("CustomerMessages", fields: [customerId], references: [id])

  @@unique([idempotencyKey])
  @@index([normalizedPhone])
  @@index([status])
  @@index([scheduledAt])
  @@index([metaMessageId])
  @@index([entityType, entityId, templateName])
  @@index([claimExpiresAt])
  @@index([mirrorStatus])
  @@map("message_logs")
}

enum EntityType {
  order
  abandoned_checkout
}

enum MessageStatus {
  pending
  processing
  sent
  delivered
  read
  failed
  skipped
  unknown
}

enum MirrorStatus {
  pending
  processing
  mirrored
  failed
}

// =====================================================================
// MANUAL INBOX
// =====================================================================

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]

  @@index([phone])
  @@map("contacts")
}

model Suppression {
  id              String   @id @default(cuid())
  normalizedPhone String   @unique
  reason          String
  source          String
  suppressedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([suppressedAt])
  @@map("suppressions")
}

model WhatsappConsent {
  id              String    @id @default(cuid())
  normalizedPhone String
  consented       Boolean
  source          String
  scope           String    @default("marketing")
  consentedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([normalizedPhone, scope])
  @@index([consented, revokedAt])
  @@map("whatsapp_consents")
}

model ContactFrequencyLock {
  normalizedPhone String   @id
  messageLogId    String
  lockedUntil     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
  @@map("contact_frequency_locks")
}

model RemarketingRun {
  id             String               @id @default(cuid())
  segment        RemarketingSegment
  mode           RemarketingRunMode
  status         RemarketingRunStatus @default(running)
  candidateCount Int                  @default(0)
  eligibleCount  Int                  @default(0)
  sentCount      Int                  @default(0)
  skippedCount   Int                  @default(0)
  failedCount    Int                  @default(0)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  recipients RemarketingRecipient[]

  @@index([segment, startedAt])
  @@index([status])
  @@map("remarketing_runs")
}

model RemarketingRecipient {
  id                  String                     @id @default(cuid())
  runId               String
  normalizedPhoneHash String
  entityType          EntityType
  entityId            String
  templateName        String
  status              RemarketingRecipientStatus
  reason              String?
  eligibilitySnapshot Json
  messageLogId        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  run RemarketingRun @relation(fields: [runId], references: [id])

  @@unique([runId, entityType, entityId])
  @@index([normalizedPhoneHash])
  @@index([status])
  @@map("remarketing_recipients")
}

enum RemarketingSegment {
  abandoned_cart
  pix_pending
  boleto_pending
  recent_customer
  inactive_customer
  vip_customer
  engaged_no_purchase
}

enum RemarketingRunMode {
  preview
  send
}

enum RemarketingRunStatus {
  running
  completed
  failed
}

enum RemarketingRecipientStatus {
  eligible
  suppressed
  queued
  sent
  failed
}

model Conversation {
  id            String             @id @default(cuid())
  contactId     String
  status        ConversationStatus @default(open)
  assignedTo    String?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  contact  Contact       @relation(fields: [contactId], references: [id])
  messages ChatMessage[]

  @@index([contactId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([lastInboundAt])
  @@map("conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  waMessageId    String?          @unique
  direction      MessageDirection
  type           ChatMessageType
  body           String?
  rawPayload     Json?
  status         String?
  timestamp      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([direction])
  @@index([type])
  @@index([timestamp])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum ChatMessageType {
  text
  image
  audio
  document
  sticker
  interactive
  template
  other
}

// =====================================================================
// WEBHOOK EVENTS
// =====================================================================

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    WebhookProvider
  topic       String?
  externalId  String?
  hmacValid   Boolean?
  rawPayload  Json
  headers     Json
  processed   Boolean         @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([provider])
  @@index([topic])
  @@index([externalId])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_events")
}

enum WebhookProvider {
  nuvemshop
  meta
  mercado_pago_future
}

// =====================================================================
// AI CAMPAIGN INTELLIGENCE
// =====================================================================
// Deliberately lean: 2 tables instead of the 8 originally sketched.
// Strategies/audience-snapshot/results are JSON on CampaignDraft because
// they are always read/written together as one artifact and never queried
// independently — a join table would add migration surface with no
// query benefit. AiRun is separate because it is an append-only audit
// trail with its own lifecycle (one row per provider call).

model CampaignDraft {
  id                 String              @id @default(cuid())
  opportunityId      String
  opportunityType    OpportunityType
  opportunityTitle   String
  status             CampaignStatus      @default(DRAFT)
  // Final Pre-Activation Readiness — Activation Wiring v2: uma key por ação
  // humana (gerada no frontend via crypto.randomUUID()), garantindo que um
  // retry da mesma tentativa nunca chame a IA duas vezes. Nullable porque só
  // passou a ser exigida a partir desta rodada (drafts antigos não têm). A
  // UNIQUE nasce junto com campaign_drafts na própria migration inicial
  // (prisma/migrations/20260915173122_add_ai_campaign_intelligence) — NÃO
  // aplicada no banco ainda (nenhuma migration foi rodada nesta rodada).
  idempotencyKey     String?             @unique
  audienceSnapshot   Json
  strategies         Json?
  selectedStrategy   Int?
  productTruthStatus ProductTruthStatus  @default(PENDING)
  complianceStatus   ComplianceStatus    @default(PENDING)
  complianceFindings Json?
  approvedBy         String?
  approvedAt         DateTime?
  scheduledAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  results            Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  aiRuns AiRun[]

  @@index([status])
  @@index([opportunityType])
  @@index([createdAt])
  @@map("campaign_drafts")
}

model AiRun {
  id              String          @id @default(cuid())
  campaignDraftId String?
  provider        String
  model           String
  promptVersion   String
  inputHash       String
  outputHash      String?
  status          AiRunStatus     @default(ok)
  errorMessage    String?
  createdAt       DateTime        @default(now())

  campaignDraft CampaignDraft? @relation(fields: [campaignDraftId], references: [id])

  @@index([campaignDraftId])
  @@index([createdAt])
  @@map("ai_runs")
}

enum OpportunityType {
  ABANDONED_CART
  PIX_PENDING
  BOLETO_PENDING
  REPEAT_PURCHASE
  WINBACK
  VIP
  RECENT_CUSTOMER
  ENGAGED_NO_PURCHASE
}

enum CampaignStatus {
  DRAFT
  AI_READY
  PRODUCT_TRUTH_APPROVED
  COMPLIANCE_APPROVED
  AWAITING_HUMAN_APPROVAL
  APPROVED
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

enum ProductTruthStatus {
  PENDING
  APPROVED
  BLOCKED
  NOT_APPLICABLE
}

enum ComplianceStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum AiRunStatus {
  ok
  error
}
