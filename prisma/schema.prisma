generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// CUSTOMERS
// =====================================================================

model Customer {
  id                       String   @id @default(cuid())
  name                     String
  email                    String?
  phone                    String?
  normalizedPhone          String
  normalizedPhoneValidated String?
  phoneNote                String?
  optOut                   Boolean  @default(false)
  source                   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  orders             Order[]
  abandonedCheckouts AbandonedCheckout[]
  messageLogs        MessageLog[]        @relation("CustomerMessages")

  @@index([normalizedPhone])
  @@index([email])
  @@index([optOut])
  @@map("customers")
}

// =====================================================================
// ORDERS
// =====================================================================

model Order {
  id               String    @id @default(cuid())
  nuvemshopOrderId String    @unique
  orderNumber      String
  customerId       String?
  customerName     String
  customerEmail    String?
  customerPhone    String?
  normalizedPhone  String
  total            Decimal   @db.Decimal(12, 2)
  currency         String    @default("BRL")
  paymentStatus    String
  paymentMethod    String?
  status           String
  orderUrl         String?
  webhookTopic     String?
  rawPayload       Json
  source           String?
  sourceCreatedAt  DateTime?
  sourceUpdatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer           Customer?           @relation(fields: [customerId], references: [id])
  convertedCheckouts AbandonedCheckout[] @relation("ConvertedCheckoutOrder")

  @@index([nuvemshopOrderId])
  @@index([normalizedPhone])
  @@index([customerEmail])
  @@index([paymentStatus])
  @@index([status])
  @@index([webhookTopic])
  @@index([sourceCreatedAt])
  @@map("orders")
}

// =====================================================================
// ABANDONED CHECKOUTS
// =====================================================================

model AbandonedCheckout {
  id                   String                  @id @default(cuid())
  nuvemshopCheckoutId  String                  @unique
  token                String?
  customerId           String?
  customerName         String
  customerEmail        String?
  customerPhone        String?
  normalizedPhone      String
  total                Decimal?                @db.Decimal(12, 2)
  currency             String                  @default("BRL")
  productsSummary      String?
  abandonedCheckoutUrl String
  status               AbandonedCheckoutStatus @default(abandoned)
  rawPayload           Json
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  convertedAt          DateTime?
  convertedOrderId     String?
  sourceCreatedAt      DateTime?
  sourceUpdatedAt      DateTime?
  abandonedAt          DateTime?
  collectedAt          DateTime                @default(now())
  source               String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  customer       Customer? @relation(fields: [customerId], references: [id])
  convertedOrder Order?    @relation("ConvertedCheckoutOrder", fields: [convertedOrderId], references: [id])

  @@index([nuvemshopCheckoutId])
  @@index([normalizedPhone])
  @@index([customerEmail])
  @@index([status])
  @@index([convertedAt])
  @@index([sourceCreatedAt])
  @@index([sourceUpdatedAt])
  @@index([convertedOrderId])
  @@map("abandoned_checkouts")
}

enum AbandonedCheckoutStatus {
  abandoned
  converted
  skipped
}

// =====================================================================
// WHATSAPP TEMPLATES
// =====================================================================

model WhatsappTemplate {
  id               String           @id @default(cuid())
  name             String
  eventType        String
  metaTemplateName String
  languageCode     String           @default("pt_BR")
  category         TemplateCategory
  messagePreview   String
  variables        Json
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([eventType])
  @@index([metaTemplateName])
  @@index([active])
  @@index([category])
  @@map("whatsapp_templates")
}

enum TemplateCategory {
  utility
  marketing
  authentication
}

// =====================================================================
// AUTOMATION RULES
// =====================================================================

model AutomationRule {
  id                String    @id @default(cuid())
  name              String
  eventType         EventType
  templateName      String
  delayMinutes      Int       @default(0)
  active            Boolean   @default(true)
  maxSendsPerEntity Int       @default(1)
  stopIfOrderExists Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([eventType])
  @@index([active])
  @@index([templateName])
  @@map("automation_rules")
}

enum EventType {
  order_created
  abandoned_checkout
  order_created_boleto
  boleto_expiring
  order_created_pix
  payment_confirmed
  payment_rejected
  pix_cancelled
}

// =====================================================================
// MESSAGE LOGS
// =====================================================================

model MessageLog {
  id                 String        @id @default(cuid())
  idempotencyKey     String
  entityType         EntityType
  entityId           String
  customerId         String?
  normalizedPhone    String
  templateName       String
  status             MessageStatus @default(pending)
  reason             String?
  errorCode          String?
  metaMessageId      String?
  acceptedAt         DateTime?
  deliveryUnknownAt  DateTime?
  claimOwner         String?
  claimExpiresAt     DateTime?
  templateLanguage   String?
  templateParameters Json?
  renderedPreview    String?
  templateHash       String?
  mirrorStatus       MirrorStatus  @default(pending)
  mirrorRetryCount   Int           @default(0)
  mirrorLastError    String?
  mirroredAt         DateTime?
  payload            Json?
  response           Json?
  retryCount         Int           @default(0)
  lastRetryAt        DateTime?
  nextRetryAt        DateTime?
  scheduledAt        DateTime
  sentAt             DateTime?
  source             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer Customer? @relation("CustomerMessages", fields: [customerId], references: [id])

  @@unique([idempotencyKey])
  @@index([normalizedPhone])
  @@index([status])
  @@index([scheduledAt])
  @@index([metaMessageId])
  @@index([entityType, entityId, templateName])
  @@index([claimExpiresAt])
  @@index([mirrorStatus])
  @@map("message_logs")
}

enum EntityType {
  order
  abandoned_checkout
}

enum MessageStatus {
  pending
  processing
  sent
  delivered
  read
  failed
  skipped
  unknown
}

enum MirrorStatus {
  pending
  processing
  mirrored
  failed
}

// =====================================================================
// MANUAL INBOX
// =====================================================================

model Contact {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]

  @@index([phone])
  @@map("contacts")
}

model Suppression {
  id              String   @id @default(cuid())
  normalizedPhone String   @unique
  reason          String
  source          String
  suppressedAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([suppressedAt])
  @@map("suppressions")
}

model ContactFrequencyLock {
  normalizedPhone String   @id
  messageLogId    String
  lockedUntil     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lockedUntil])
  @@map("contact_frequency_locks")
}

model RemarketingRun {
  id             String               @id @default(cuid())
  segment        RemarketingSegment
  mode           RemarketingRunMode
  status         RemarketingRunStatus @default(running)
  candidateCount Int                  @default(0)
  eligibleCount  Int                  @default(0)
  sentCount      Int                  @default(0)
  skippedCount   Int                  @default(0)
  failedCount    Int                  @default(0)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  recipients RemarketingRecipient[]

  @@index([segment, startedAt])
  @@index([status])
  @@map("remarketing_runs")
}

model RemarketingRecipient {
  id                  String                     @id @default(cuid())
  runId               String
  normalizedPhoneHash String
  entityType          EntityType
  entityId            String
  templateName        String
  status              RemarketingRecipientStatus
  reason              String?
  eligibilitySnapshot Json
  messageLogId        String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  run RemarketingRun @relation(fields: [runId], references: [id])

  @@unique([runId, entityType, entityId])
  @@index([normalizedPhoneHash])
  @@index([status])
  @@map("remarketing_recipients")
}

enum RemarketingSegment {
  abandoned_cart
  pix_pending
  boleto_pending
  recent_customer
  inactive_customer
  vip_customer
  engaged_no_purchase
}

enum RemarketingRunMode {
  preview
  send
}

enum RemarketingRunStatus {
  running
  completed
  failed
}

enum RemarketingRecipientStatus {
  eligible
  suppressed
  queued
  sent
  failed
}

model Conversation {
  id            String             @id @default(cuid())
  contactId     String
  status        ConversationStatus @default(open)
  assignedTo    String?
  lastMessageAt DateTime?
  lastInboundAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  contact  Contact       @relation(fields: [contactId], references: [id])
  messages ChatMessage[]

  @@index([contactId])
  @@index([status])
  @@index([lastMessageAt])
  @@index([lastInboundAt])
  @@map("conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  waMessageId    String?          @unique
  direction      MessageDirection
  type           ChatMessageType
  body           String?
  rawPayload     Json?
  status         String?
  timestamp      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([direction])
  @@index([type])
  @@index([timestamp])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum ChatMessageType {
  text
  image
  audio
  document
  sticker
  interactive
  template
  other
}

// =====================================================================
// WEBHOOK EVENTS
// =====================================================================

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    WebhookProvider
  topic       String?
  externalId  String?
  hmacValid   Boolean?
  rawPayload  Json
  headers     Json
  processed   Boolean         @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([provider])
  @@index([topic])
  @@index([externalId])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_events")
}

enum WebhookProvider {
  nuvemshop
  meta
  mercado_pago_future
}
