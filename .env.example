# =====================================================================
# AMBIENTE
# =====================================================================
NODE_ENV=development
PORT=3000
APP_BASE_URL=

# =====================================================================
# BANCO DE DADOS
# =====================================================================
DATABASE_URL=
DIRECT_URL=

# =====================================================================
# MODO PREVIEW SOMENTE-LEITURA
# =====================================================================
# true  → boot exige apenas DATABASE_URL, DIRECT_URL e CRM_READ_SECRET;
#         nenhuma rota de mutação/admin/jobs/webhooks é montada e nenhum
#         cron interno inicia. Uso exclusivo de ambientes Preview.
# false → comportamento padrão (produção), inalterado.
CRM_PREVIEW_READONLY=false

# =====================================================================
# NUVEMSHOP
# =====================================================================
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT=DrosaRecovery (contato@drosamoda.com.br)
NUVEMSHOP_API_VERSION=v1
WEBHOOK_SECRET=

# =====================================================================
# META / WHATSAPP CLOUD API
# =====================================================================
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v20.0
META_VERIFY_TOKEN=
META_APP_SECRET=
META_REQUEST_TIMEOUT_MS=8000
WHATSAPP_API_NUMBER=558393464855
META_WABA_ID=

# =====================================================================
# AUTENTICAÇÃO INTERNA
# =====================================================================
ADMIN_SECRET=
JOBS_SECRET=
INBOX_ADMIN_SECRET=
CRM_READ_SECRET=

# =====================================================================
# TEMPLATES WHATSAPP
# =====================================================================
ORDER_CONFIRMATION_TEMPLATE=confirmacao_pedido_drosa
ABANDONED_CART_TEMPLATE=carrinho_abandonado_drosa_v2

# =====================================================================
# URLS
# =====================================================================
CHECKOUT_BASE_URL=https://www.drosamoda.com.br/checkout/

# =====================================================================
# CONFIGURAÇÕES DE MENSAGENS
# =====================================================================
DEFAULT_COUNTRY_CODE=55
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000
MESSAGES_BATCH_SIZE=20
MESSAGE_SEND_DELAY_MS=250
AUTOMATION_MAX_MESSAGE_AGE_HOURS=24

# =====================================================================
# CRON / JOBS
# =====================================================================
ENABLE_INTERNAL_CRON=false
ABANDONED_CART_ENABLED=false
REMARKETING_ENABLED=false
ABANDONED_CART_MAX_SENDS_PER_RUN=1
REMARKETING_MAX_SENDS_PER_RUN=1
PREVIEW_CONCURRENCY=2
MARKETING_SEND_HOUR_START=9
MARKETING_SEND_HOUR_END=20
MARKETING_TIME_ZONE=America/Sao_Paulo
CRON_ABANDONED_CART_INTERVAL=15
CRON_PROCESS_MESSAGES_INTERVAL=1
ABANDONED_CART_LOOKBACK_HOURS=2

# =====================================================================
# SENTRY (OPCIONAL)
# =====================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =====================================================================
# MODO DRY RUN / GATES DE ENVIO (HOMOLOGAÇÃO)
# =====================================================================
# Fail-closed: mantenha estes valores enquanto estiver em homologação.
# Automação real exige, simultaneamente:
#   AUTOMATION_SEND_ENABLED=true
#   WHATSAPP_DRY_RUN=false
#   gate específico do fluxo=true
#   AUTOMATION_ALLOWED_TEMPLATES com allowlist explícita
WHATSAPP_DRY_RUN=true
AUTOMATION_SEND_ENABLED=false
AUTOMATION_ALLOWED_TEMPLATES=

# Inbox manual também nasce em dry-run, inclusive em production.
# Só use false quando o atendimento manual real estiver explicitamente autorizado.
INBOX_SEND_DRY_RUN=true

# Toggles internos de cron. ENABLE_INTERNAL_CRON=false impede todos.
CRON_PROCESS_MESSAGES_ENABLED=true
CRON_ABANDONED_CART_ENABLED=true
CRON_BOLETO_EXPIRING_ENABLED=true
CRON_BOLETO_EXPIRING_INTERVAL=60
BOLETO_NOTIFY_HOURS=48

# Limites / cooldowns
ABANDONED_CART_DELAY_MINUTES=30
ABANDONED_CART_COOLDOWN_HOURS=24
ABANDONED_CART_PREVIEW_LIMIT=100
ABANDONED_CART_MAX_AGE_HOURS=168
ABANDONED_CART_OVERLAP_HOURS=72
REMARKETING_GLOBAL_COOLDOWN_HOURS=24
REMARKETING_RECENT_CUSTOMER_DAYS=30
REMARKETING_INACTIVE_DAYS=90
VIP_MIN_ORDERS=3
VIP_MIN_SPEND=500
MESSAGE_CLAIM_LEASE_SECONDS=300

# =====================================================================
# AI CAMPAIGN INTELLIGENCE (server-side only — nunca exposto ao browser)
# =====================================================================
# Sem a API key do provedor escolhido, tudo o resto do CRM continua
# funcionando normalmente — só a geração de campanhas via IA fica
# indisponível (retorna 503 AI_PROVIDER_NOT_CONFIGURED em vez de derrubar
# o boot). Escolha explícita (anthropic | openai | groq) — sem fallback
# automático entre provedores.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Groq — API compatível com a da OpenAI (mesmo SDK, baseURL diferente).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# =====================================================================
# E-MAIL (consentimento, descadastro) — nenhum e-mail é enviado nesta fase
# Segredos abaixo: mínimo de 32 caracteres aleatórios, NUNCA commitar valores.
# EMAIL_HASH_PEPPER e EMAIL_UNSUBSCRIBE_SECRET devem ser DIFERENTES entre si.
# =====================================================================
EMAIL_SEND_ENABLED=false
EMAIL_HASH_PEPPER=
EMAIL_UNSUBSCRIBE_SECRET=
# Só durante rotação: a chave antiga, para os links já enviados continuarem válidos.
EMAIL_UNSUBSCRIBE_SECRET_PREVIOUS=
